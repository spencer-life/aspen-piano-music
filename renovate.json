{
  "extends": ["config:best-practices"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Keep routine non-major updates moving after CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "routine dependencies",
      "schedule": ["before 6am on monday"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Keep major upgrades isolated and manual",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group mise-managed tool updates",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    }
  ],
  "vulnerabilityAlerts": { "enabled": true }
}
